BLOOMFOLIO_ENV=dev
BLOOMFOLIO_LOG_LEVEL=INFO

BLOOMFOLIO_BASE_CURRENCY=CAD

BLOOMFOLIO_LLM_PROVIDER=ollama
BLOOMFOLIO_OLLAMA_BASE_URL=http://localhost:11434/v1
BLOOMFOLIO_OLLAMA_API_KEY=ollama
BLOOMFOLIO_OLLAMA_QUICK_MODEL=gemma4:26b
BLOOMFOLIO_OLLAMA_DEEP_MODEL=gemma4:26b

BLOOMFOLIO_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
BLOOMFOLIO_OPENROUTER_API_KEY=your-open-router-key
BLOOMFOLIO_OPENROUTER_MODEL=MiniMax/MiniMax-M2-7B

BLOOMFOLIO_MAX_DEBATE_ROUNDS=2
BLOOMFOLIO_MAX_CONCURRENT_TICKERS=2
BLOOMFOLIO_MAX_CONCURRENT_LLM_REQUESTS=1
BLOOMFOLIO_ANALYSIS_TIMEOUT_SECONDS=900

BLOOMFOLIO_ENABLE_TRADINGAGENTS=true
BLOOMFOLIO_ENABLE_FALLBACK_GRAPH=true
BLOOMFOLIO_ENABLE_NETWORK_MARKETDATA=true
BLOOMFOLIO_ENABLE_EXPERIMENTAL_ACTION_LABELS=false
